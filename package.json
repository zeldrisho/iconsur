{
  "name": "@zeldrisho/iconsur",
  "version": "1.7.0",
  "description": "Generate macOS Big Sur style adaptive icons for third-party apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeldrisho/iconsur"
  },
  "bin": {
    "iconsur": "src/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack && cp src/mask.png dist/ && pkg -c .pkgrc.json dist/index.cjs --targets node22-macos-arm64,node22-macos-x64 --output dist/iconsur",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@jimp/core": "^1.6.1",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "icns-lib": "^1.0.1",
    "jimp": "^1.6.1",
    "plist": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^24.0.0",
    "@yao-pkg/pkg": "^6.22.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.8",
    "vitest": "^4.1.10"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
