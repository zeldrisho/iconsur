{
  "name": "@zeldrisho/iconsur",
  "version": "2.1.1",
  "description": "Generate macOS Big Sur styled adaptive icons for third-party apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeldrisho/iconsur"
  },
  "bin": {
    "iconsur": "dist/index.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack && cp src/mask.png dist/ && rm -f dist/iconsur-* && pkg -c .pkgrc.json dist/index.cjs --targets node24-macos-arm64,node24-macos-x64 --output dist/iconsur",
    "check": "vp check",
    "prepack": "vp pack --no-clean && cp src/mask.png dist/ && rm -f dist/iconsur-*",
    "test": "vp test"
  },
  "dependencies": {
    "@jimp/core": "^1.6.1",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "icns-lib": "^1.0.1",
    "jimp": "^1.6.1",
    "plist": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@yao-pkg/pkg": "^6.22.0",
    "git-cliff": "^2.13.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
